<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Add NOT NULL constraints and UNIQUE constraint to business_user table.
        This changeset will only run if the constraints don't already exist.
    -->
    <changeSet id="20260204120000-2" author="jhipster" runOnChange="true">

        <!-- Add NOT NULL constraint to business_id if it doesn't exist -->
        <addNotNullConstraint
            tableName="business_user"
            columnName="business_id"
            columnDataType="bigint"/>

        <!-- Add NOT NULL constraint to user_id if it doesn't exist -->
        <addNotNullConstraint
            tableName="business_user"
            columnName="user_id"
            columnDataType="bigint"/>

        <!-- Add UNIQUE constraint on (business_id, user_id) if it doesn't exist -->
        <addUniqueConstraint
            tableName="business_user"
            columnNames="business_id, user_id"
            constraintName="uq_business_user_business_user"/>
    </changeSet>
</databaseChangeLog>