// Main application configuration
application {
  config {
    baseName multitenant          // Base name of the application
    applicationType monolith      // Monolithic application architecture
    authenticationType jwt        // JWT-based authentication
    databaseType sql             // SQL database usage
    devDatabaseType h2Disk       // H2 disk-based database for development
    prodDatabaseType mysql       // MySQL database for production
    buildTool gradle            // Gradle as the build tool
    clientFramework vue         // Vue.js as the frontend framework
    nativeLanguage en           // Default language is English
    languages [en]              // Supported languages
    clientTheme united          // United Bootstrap theme
    clientThemeVariant dark     // Dark variant of the theme
    enableHibernateCache false  // Disable Hibernate second-level cache
    messageBroker no           // No message broker integration
    packageName com.walshe.multitenant  // Root package name
    reactive false             // Non-reactive backend
    serverPort 8080           // Server port
    testFrameworks []         // No additional test frameworks specified

  }
  entities *  // Include all defined entities in this application
}

// Enum defining the possible roles a user can have within a business
enum BusinessRole {
  MEMBER
}

// Business entity representing an organization or company
entity Business {
  name String required,        // Name of the business
  slug String required unique, // Unique identifier for the business in URLs
  createdAt Instant,           // Timestamp when the business was created
  updatedAt Instant            // Timestamp when the business was last updated
}

// BusinessUser entity linking users to businesses with specific roles
entity BusinessUser {
  role BusinessRole required,  // Role of the user within the business
  createdAt Instant,           // Timestamp when the user was added to the business
  updatedAt Instant            // Timestamp when the relationship was last updated
}

// BusinessInvitation entity for managing invitations to join a business
entity BusinessInvitation {
  role BusinessRole required,   // Role the invited user will have if they accept
  token String required unique, // Unique token for the invitation
  invitedEmail String required, // Email address of the invited user
  createdAt Instant,            // Timestamp when the invitation was created
  updatedAt Instant             // Timestamp when the invitation was last updated
}

// Relationship: A business has one owner who is a User (built-in JHipster entity)
relationship ManyToOne {
  Business{owner(login)} to User with builtInEntity
}

// Relationships: BusinessUser connects businesses and users
relationship ManyToOne {
  BusinessUser{business(name)} to Business,  // BusinessUser belongs to a Business
  BusinessUser{user(login)} to User with builtInEntity  // BusinessUser references a User
}

// Relationships: BusinessInvitation connects businesses with the user who sent the invitation
relationship ManyToOne {
  BusinessInvitation{business(name)} to Business,        // Invitation belongs to a Business
  BusinessInvitation{invitedBy(login)} to User with builtInEntity  // Invitation sent by a User
}

// Global options for all entities
filter all                    // Enable filtering capabilities
paginate all with pagination  // Enable pagination
dto all with mapstruct        // Generate DTOs with MapStruct
service all with serviceClass // Generate service classes